# 自动获取登录 Cookie（不用再手动 F12 复制）
#   profile : 专用浏览器，首次弹窗登录一次，之后每次运行自动刷新（推荐）
#   safari / chrome / edge / firefox / brave : 直接读取日常浏览器里的登录（需 pip install browser-cookie3）
#     safari 需给终端开"完全磁盘访问权限"（系统设置 → 隐私与安全性）
#   留空或 false : 关闭，使用下面手动填写的 DY_COOKIES
DY_AUTO_COOKIE=profile
# 抖音 cookie（主项目接口认证）
DY_COOKIES=''
# 直播弹幕 cookie
DY_LIVE_COOKIES=''
# 登录凭证（扫码登录后由 login_grab_ticket 自动写入，用于私信签名）
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''
