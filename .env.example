# 自动获取登录 Cookie（不用再手动 F12 复制）
#   profile : 专用浏览器，首次弹窗登录一次，之后每次运行自动刷新（推荐）
#   safari / chrome / edge / firefox / brave : 直接读取日常浏览器里的登录（需 pip install browser-cookie3）
#     safari 需给终端开"完全磁盘访问权限"（系统设置 → 隐私与安全性）
#   留空或 false : 关闭，使用下面手动填写的 DY_COOKIES
DY_AUTO_COOKIE=profile
# 抖音 cookie（主项目接口认证）
DY_COOKIES=''
# 直播弹幕 cookie
DY_LIVE_COOKIES=''
# 登录凭证（扫码登录后由 login_grab_ticket 自动写入，用于私信签名）
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''

# ---------------- 防风控（默认值偏保守：宁可慢，也要稳） ----------------
# 总开关，0 = 关闭（不推荐）
DY_SAFE_MODE=1
# 两次请求之间的随机间隔（秒），"最小-最大"
DY_REQ_INTERVAL=3-6
# 每分钟 / 每小时 / 每天最多请求多少次（每天的额度跨多次运行累计，次日清零）
DY_REQ_PER_MIN=10
DY_REQ_PER_HOUR=300
DY_REQ_PER_DAY=2000
# 每连续请求多少次后休息一下，以及休息多少秒
DY_REST_EVERY=40-60
DY_REST_SECONDS=90-240
# 触发风控后第一次暂停多少秒（之后每次翻倍：5 → 10 → 20 分钟），最多重试几次
DY_RISK_BACKOFF=300
DY_RISK_MAX_RETRY=3
